{{ product_details }}

<h4 class="mt-4 mb-1"><strong>{{ 'Your Instance'|trans }}</strong></h4>

<div class="mb-3">
    <div class="form-check">
        <input class="form-check-input" type="radio" name="domain_type" id="domain_type_subdomain"
               value="subdomain" checked>
        <label class="form-check-label" for="domain_type_subdomain">
            {{ 'Use a udp.social subdomain'|trans }}
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="radio" name="domain_type" id="domain_type_byod"
               value="byod">
        <label class="form-check-label" for="domain_type_byod">
            {{ 'Use my own domain'|trans }}
        </label>
    </div>
</div>

{# Subdomain picker #}
<div id="udp-subdomain-section" class="mb-3">
    <label class="form-label">{{ 'Choose your subdomain'|trans }}</label>
    <div class="d-flex align-items-center gap-2" style="max-width: 540px;">
        <div class="input-group">
            <input type="text" class="form-control" id="udp-subdomain-input" name="subdomain"
                   placeholder="yourfamily" autocomplete="off" spellcheck="false"
                   pattern="[a-z0-9][a-z0-9\-]{0,61}[a-z0-9]">
            <select class="form-select flex-grow-0" style="max-width: 160px;" name="domain" id="udp-domain-select">
                <option value="udp.social">.udp.social</option>
            </select>
        </div>
        <button type="button" class="btn btn-secondary btn-sm text-nowrap" id="udp-check-btn">
            {{ 'Check'|trans }}
        </button>
    </div>
    <div id="udp-subdomain-feedback" class="form-text mt-1" aria-live="polite"></div>
</div>

{# Username #}
<div class="mb-3">
    <label class="form-label" for="udp-customer-username">{{ 'Choose a username'|trans }}</label>
    <input type="text" class="form-control" id="udp-customer-username"
           name="customer_username" placeholder="jsmith"
           pattern="[a-z0-9][a-z0-9_\-]{0,30}"
           style="max-width: 260px;" autocomplete="off" spellcheck="false" required>
    <div class="form-text">{{ 'Used to log in to your Friendica instance.'|trans }}</div>
</div>

{# BYOD input #}
<div id="udp-byod-section" class="mb-3" style="display:none;">
    <label class="form-label" for="udp-custom-domain">{{ 'Your domain'|trans }}</label>
    <input type="text" class="form-control" id="udp-custom-domain" name="custom_domain"
           placeholder="myfamily.example.com" style="max-width: 360px;"
           autocomplete="off" spellcheck="false">
    <div class="form-text">
        {{ 'Point your domain\'s DNS A record to your instance IP after setup. We\'ll send instructions.'|trans }}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const subdomainSection = document.getElementById('udp-subdomain-section');
    const byodSection      = document.getElementById('udp-byod-section');
    const subdomainInput   = document.getElementById('udp-subdomain-input');
    const domainSelect     = document.getElementById('udp-domain-select');
    const checkBtn         = document.getElementById('udp-check-btn');
    const feedback         = document.getElementById('udp-subdomain-feedback');
    const nextBtn          = document.getElementById('config-next');
    const domainTypeInputs = document.querySelectorAll('input[name="domain_type"]');

    // The update-service addon ID is embedded server-side so JS can reference it.
    // Set to null if not applicable (L1 has no addon).
    const updateAddonId = {{ update_addon_id is defined ? update_addon_id : 'null' }};

    let subdomainConfirmed = false;

    function setNextEnabled(enabled) {
        if (nextBtn) {
            nextBtn.disabled = !enabled;
            nextBtn.style.display = '';
        }
    }

    function resetSubdomainState() {
        subdomainConfirmed = false;
        feedback.textContent = '';
        feedback.className = 'form-text mt-1';
        setNextEnabled(false);
    }

    function onDomainTypeChange() {
        const type = document.querySelector('input[name="domain_type"]:checked').value;

        if (type === 'subdomain') {
            subdomainSection.style.display = '';
            byodSection.style.display = 'none';
            // Disable BYOD field so it isn't submitted
            document.getElementById('udp-custom-domain').disabled = true;
            subdomainInput.disabled = false;
            setNextEnabled(subdomainConfirmed);
            lockAddon(true);
        } else {
            subdomainSection.style.display = 'none';
            byodSection.style.display = '';
            document.getElementById('udp-custom-domain').disabled = false;
            subdomainInput.disabled = true;
            setNextEnabled(true);
            lockAddon(false);
        }
    }

    // Lock or unlock the update-service addon based on subdomain requirement.
    function lockAddon(required) {
        if (!updateAddonId) return;
        const addBtn     = document.getElementById('addon_' + updateAddonId);
        const declineBtn = document.getElementById('addon_' + updateAddonId + '_decline');
        if (!addBtn || !declineBtn) return;

        if (required) {
            addBtn.checked = true;
            declineBtn.disabled = true;
            declineBtn.closest('label').setAttribute('title',
                '{{ 'Required for udp.social subdomains'|trans }}');
        } else {
            declineBtn.disabled = false;
            declineBtn.closest('label').removeAttribute('title');
        }
    }

    function checkAvailability() {
        const label  = subdomainInput.value.trim().toLowerCase();
        const domain = domainSelect.value;
        if (!label) {
            feedback.textContent = '{{ 'Please enter a subdomain label.'|trans }}';
            feedback.className = 'form-text mt-1 text-warning';
            return;
        }

        checkBtn.disabled = true;
        feedback.textContent = '{{ 'Checking…'|trans }}';
        feedback.className = 'form-text mt-1 text-secondary';

        API.guest.post(
            'servicecustom/check_subdomain',
            { subdomain: label, domain: domain },
            function (result) {
                checkBtn.disabled = false;
                if (result.available) {
                    subdomainConfirmed = true;
                    feedback.textContent = label + '.' + domain + ' {{ 'is available!'|trans }}';
                    feedback.className = 'form-text mt-1 text-success';
                    setNextEnabled(true);
                } else {
                    subdomainConfirmed = false;
                    const msg = result.reason === 'invalid'
                        ? '{{ 'Invalid subdomain. Use only letters, numbers, and hyphens.'|trans }}'
                        : '{{ 'That subdomain is taken. Please try another.'|trans }}';
                    feedback.textContent = msg;
                    feedback.className = 'form-text mt-1 text-danger';
                    setNextEnabled(false);
                }
            },
            function () {
                checkBtn.disabled = false;
                feedback.textContent = '{{ 'Could not check availability. Please try again.'|trans }}';
                feedback.className = 'form-text mt-1 text-danger';
            }
        );
    }

    // Wire up events
    checkBtn.addEventListener('click', checkAvailability);

    subdomainInput.addEventListener('input', resetSubdomainState);
    domainSelect.addEventListener('change', resetSubdomainState);
    subdomainInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            checkAvailability();
        }
    });

    domainTypeInputs.forEach(function (input) {
        input.addEventListener('change', onDomainTypeChange);
    });

    // Initial state: subdomain selected, Next disabled until check passes
    nextBtn.disabled = true;
    lockAddon(true);
});
</script>
